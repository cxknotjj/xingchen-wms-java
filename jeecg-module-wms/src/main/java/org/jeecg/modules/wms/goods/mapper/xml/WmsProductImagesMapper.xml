<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.wms.goods.mapper.WmsProductImagesMapper">

    <select id="queryList" parameterType="String" resultType="org.jeecg.modules.wms.goods.entity.WmsProductImages">
        select * from wms_product_images
        <where>
            <if test="productId != null and productId != ''">
                product_id = #{productId}
            </if>
        </where>
    </select>
</mapper>